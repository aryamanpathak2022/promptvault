{
  "name": "promptvault",
  "version": "1.0.0",
  "description": "Git-like version control for LLM prompts. CLI + MCP server for Claude Code / Cursor.",
  "keywords": [
    "prompt",
    "llm",
    "version-control",
    "ai",
    "mcp",
    "claude",
    "cursor",
    "prompt-engineering",
    "cli"
  ],
  "homepage": "https://github.com/aryamanpathak2022/promptvault",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryamanpathak2022/promptvault.git"
  },
  "license": "MIT",
  "author": "aryamanpathak2022",
  "bin": {
    "pv": "./dist/cli/index.js",
    "promptvault": "./dist/cli/index.js",
    "pv-mcp": "./dist/cli/mcp/server.js"
  },
  "files": [
    "dist/cli/**/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:cli && npm run build:web",
    "build:cli": "tsc -p cli/tsconfig.json",
    "build:web": "prisma generate && next build",
    "build:mcp": "tsc -p cli/tsconfig.json",
    "start": "next start",
    "pv": "tsx cli/index.ts",
    "mcp": "tsx cli/mcp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p cli/tsconfig.json --noEmit",
    "prepublishOnly": "npm run build:cli",
    "postinstall": "prisma generate || true"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "diff": "^8.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.20.0",
    "picocolors": "^1.1.1",
    "prisma": "^7.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
